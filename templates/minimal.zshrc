export ZSH="$HOME/.oh-my-zsh"

# Plugins to load, from $ZSH_CUSTOM/plugins/ and $ZSH/plugins/ (copy in the
# ones you need). Note: zsh-syntax-highlighting should come last.
# plugins=(zsh-autosuggestions zsh-syntax-highlighting)
plugins=()

source $ZSH/oh-my-zsh.sh

# Prompt is handled by starship (https://starship.rs)
# eval "$(starship init zsh)"

# Your own scripts in $ZSH/custom (files ending in .zsh) are sourced automatically.
